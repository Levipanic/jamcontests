APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
# TRUSTED_PROXIES=127.0.0.1, 10.0.0.0/8
DATABASE_URL=postgres://jamcontests:jamcontests@localhost:5432/jamcontests?sslmode=disable
# In production, use a separate owner role for migrations. The serve command
# never reads this variable; migrations refuse to run without it outside
# development.
MIGRATION_DATABASE_URL=postgres://jamcontests:jamcontests@localhost:5432/jamcontests?sslmode=disable
# Optional for integration tests; use a disposable database or a role allowed to create schemas.
TEST_DATABASE_URL=postgres://jamcontests:jamcontests@localhost:5432/jamcontests?sslmode=disable
CSRF_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE=jamcontests_session
SESSION_TTL=720h
MIGRATIONS_DIR=migrations
TEMPLATES_DIR=templates
STATIC_DIR=static
AVATAR_DIR=storage/avatars
MAX_AVATAR_BYTES=2097152
