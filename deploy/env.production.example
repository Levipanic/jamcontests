# Production environment for Jam Contests. Copy to /etc/jamcontests/jamcontests.env,
# set owner to root and mode 0600. The application never logs secrets.
#
# APP_ENV=production
# HTTP_ADDR=127.0.0.1:8080
# LOG_LEVEL=info
#
# DATABASE_URL names the runtime role with least privileges. Credentials and
# host must be adjusted for the real cluster; see deploy/sql/production_roles.sql
# and docs/production.md.
# DATABASE_URL=postgres://jamcontests_runtime:CHANGE-ME@127.0.0.1:5432/jamcontests?sslmode=verify-full
#
# CSRF_SECRET must be at least 32 random bytes, generated once and kept secret:
#   openssl rand -base64 48
# CSRF_SECRET=CHANGE-ME
#
# TRUSTED_PROXIES lists the reverse proxy addresses that may supply
# X-Forwarded-For. Leave empty when the app is reached directly.
# TRUSTED_PROXIES=127.0.0.1
#
# SESSION_COOKIE=jamcontests_session
# SESSION_TTL=720h
# MIGRATIONS_DIR=migrations
# TEMPLATES_DIR=templates
# STATIC_DIR=static
# AVATAR_DIR=storage/avatars
# MAX_AVATAR_BYTES=2097152
#
# MIGRATION_DATABASE_URL is never used by the server; run migrations by hand
# with the owner role: sudo -u jamcontests /opt/jamcontests/bin/jamcontests migrate
